# syntax=docker/dockerfile:1.27@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# The runtime tree alone — the nu scripts a build stage COPYs onto its PATH to
# call `bayt fingerprint` / `bayt cache`. No CUE: the generator runs on the
# host and never enters a container.
#
# Must reference no bayt artifact: the generator pins this by digest, so a
# reference back would make that pin a self-reference with no fixed point.
#
# Root IS the runtime tree, so consumers COPY `.`.
FROM scratch
COPY runtime/ /
